# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---
# Local dev / CI default (no setup required):
DATABASE_URL=sqlite:///./data/dev.db
# Docker Compose / production:
# DATABASE_URL=postgresql://raguser:ragpass@postgres:5432/ragdb

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
# CACHE_ENABLED=true wraps retrieval (embedding + vector/BM25 search) in a Redis
# cache keyed on query+top_k+document_ids+retrieval_mode+embedding_model. Bounded
# staleness: a cache hit can miss a document ingested/deleted up to
# CACHE_TTL_SECONDS ago — see docs/decisions/0017-phase17-caching.md.
CACHE_ENABLED=false
CACHE_TTL_SECONDS=3600

# --- Job queue (Phase 16) ---
# "background_tasks" (default): ingestion runs in-process via FastAPI
# BackgroundTasks, no Redis required. "rq": enqueues onto Redis; requires a running
# `python workers/ingestion_worker.py` (docker-compose's `worker` service) to
# actually process jobs. See docs/decisions/0016-phase16-async-job-queue.md.
JOB_QUEUE_BACKEND=background_tasks
JOB_QUEUE_NAME=ingestion
JOB_QUEUE_TIMEOUT_SECONDS=600

# --- Embeddings ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Chunking ---
CHUNKING_STRATEGY=recursive
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60

# --- Vector store ---
# local = no external account needed (default). pinecone = requires the keys below.
VECTOR_STORE=local
PINECONE_API_KEY=
PINECONE_INDEX=multimodal-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- LLM ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
# Grounded generation (Phase 10): below this top-chunk score, abstain entirely;
# at/above it but below the high-confidence bar, answer labeled "low" confidence.
GROUNDING_CONFIDENCE_THRESHOLD=0.35
GROUNDING_HIGH_CONFIDENCE_THRESHOLD=0.6

# --- Security ---
API_KEY=
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# --- OCR (Phase 4) ---
# Requires the Tesseract and Poppler system binaries (see
# docs/decisions/0004-phase4-multimodal-processing.md for install instructions).
# Leave both paths blank to search PATH (works out of the box on Linux/Docker after
# `apt-get install tesseract-ocr poppler-utils`, and in CI). On Windows, PATH often
# isn't refreshed until a new shell after installing, so set the exact paths here.
OCR_ENABLED=true
OCR_TESSERACT_CMD=
OCR_POPPLER_PATH=
VISION_DESCRIPTION_ENABLED=true

# --- Retrieval mode (Phase 6) ---
# dense = Phase 1-5 baseline (default). hybrid = dense + BM25 fusion, measured to
# improve ranking quality at ~3x retrieval latency (see docs/decisions/0006-*.md).
RETRIEVAL_MODE=dense
HYBRID_FUSION_METHOD=rrf
HYBRID_RRF_K=60
HYBRID_DENSE_WEIGHT=0.5
HYBRID_SPARSE_WEIGHT=0.5
HYBRID_CANDIDATE_POOL=20

# --- Reranking (Phase 7) ---
# Opt-in: measured to NOT improve ranking quality on this project's seed dataset
# (see docs/decisions/0007-*.md) at ~42x latency, so it defaults to off.
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_POOL=30

# --- Query intelligence (Phase 8) ---
# Opt-in. Requires ANTHROPIC_API_KEY for rewriting/decomposition/expansion to do
# anything real — without a key, each step degrades to a no-op (see ADR 0008).
QUERY_INTELLIGENCE_ENABLED=false
QUERY_REWRITE_ENABLED=true
QUERY_DECOMPOSITION_ENABLED=true
QUERY_EXPANSION_ENABLED=false
QUERY_SHORT_WORD_THRESHOLD=4
CONVERSATION_HISTORY_MAX_TURNS=5

# --- Context engineering (Phase 9) ---
# All opt-in / no-op by default — see docs/decisions/0009-*.md.
CONTEXT_MAX_TOKENS=3000
CONTEXT_RELEVANCE_FLOOR_RATIO=0.0
CONTEXT_MAX_CHUNKS_PER_DOCUMENT=
CONTEXT_COMPRESSION_ENABLED=false
CONTEXT_MAX_CHUNK_TOKENS=300

# --- Citation validation (Phase 11) ---
# Deterministic and cheap (no LLM call) — on by default, unlike hybrid/rerank/query
# intelligence. See docs/decisions/0011-*.md.
CITATION_VALIDATION_ENABLED=true
CITATION_OVERLAP_THRESHOLD=0.5
